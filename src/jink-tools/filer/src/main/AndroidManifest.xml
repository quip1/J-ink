<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- "All files access" (Android 11+) lets a file manager see the whole storage, like Font Drop. -->
  <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29"/>
  <!-- Lets tapping an .apk in Filer hand it to the system installer. -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
  <application android:label="Filer" android:icon="@drawable/ic_launcher"
      android:allowBackup="true" android:theme="@style/Theme.Ink" android:requestLegacyExternalStorage="true">
    <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize|stateHidden">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
    <provider android:name=".FilesProvider" android:authorities="dev.jacob.filer.files"
        android:exported="false" android:grantUriPermissions="true"/>
  </application>
</manifest>
